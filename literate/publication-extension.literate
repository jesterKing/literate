                const forwarding = progressToken.onCancellationRequested(() => operation.source.cancel());
                if (progressToken.isCancellationRequested) { operation.source.cancel(); }
                try {
                    await serialize(async () => {
```

Snapshot capture occurs after queue acquisition. Cancellation is checked before
source capture or spawn. Revalidating the canonical root and folder prevents a
stale selection granting authority to another workspace. The serializer holds the
queue until the helper closes and its response is validated; its owner advances
the queue on resolution or rejection, never merely on a cancellation request.

```typescript: <<publication extension commands>>=+
                        cancelled(token);
                        await canonicalRoot(folder);
                        if (project) { await canonicalProjectRoot(workspaceRoot, project.root); }
                        authority();
                        if (series) {
                            const publicationDocuments: Record<string, SourceDocument[]> = Object.create(null);
                            for (const item of series.publications) {
                                cancelled(token);
                                const projectRoot = await canonicalProjectRoot(workspaceRoot, item.root);
                                authority();
                                publicationDocuments[item.id] = await capturePublicationSnapshot(projectRoot, token);
                                if (manifest) { await checkPath(projectRoot, manifest); }
                            }
                            const args = ['pdf', workspaceRoot];
                            if (browser) { args.push('--browser', browser); }
                            if (manifest) { args.push('--font-manifest', manifest); }
                            args.push('--json');
                            await canonicalRoot(folder);
                            authority();
                            cancelled(token);
                            const result = await bridge(node, context.asAbsolutePath('out/publication-helper.cjs'), workspaceRoot,
                                { args, documents: [], publicationDocuments }, token,
                                text => { output.appendLine(text); progress.report({ message: text }); });
                            if (result.stderr) { output.appendLine(result.stderr); }
                            const outcome = seriesPublicationOutcome(result, series.publications.map(item => item.pdf!));
                            for (const item of series.publications) {
                                completed = path.resolve(workspaceRoot, item.pdf!);
                                output.appendLine(`Publication completed: ${completed}`);
                            }
                            for (const warning of outcome.warnings) { output.appendLine(`Warning: ${warning}`); }
                            if (outcome.elapsedMs !== undefined) {
                                output.appendLine(`Publication finished in ${elapsedPublicationTime(outcome.elapsedMs)}`);
                            }
                        } else {
                            const documents = await capturePublicationSnapshot(root, token);
                            const args = [kind, root, '--output', choice!.destination, '--paper', choice!.paper];
                            ['top', 'outer', 'bottom', 'inner'].forEach((side, index) => {
                                args.push(`--margin-${side}`, `${choice!.margins.split(',')[index]}mm`);
                            });
                            if (browser) { args.push('--browser', browser); }
                            if (manifest) { await checkPath(root, manifest); args.push('--font-manifest', manifest); }
                            args.push('--json');
                            await canonicalRoot(folder);
                            if (project) { await canonicalProjectRoot(workspaceRoot, project.root); }
                            await checkPath(root, choice!.destination);
                            authority();
                            cancelled(token);
                            const result = await bridge(node, context.asAbsolutePath('out/publication-helper.cjs'), root,
                                { args, documents }, token, text => { output.appendLine(text); progress.report({ message: text }); });
                            if (result.stderr) { output.appendLine(result.stderr); }
                            const outcome = publicationOutcome(result, kind, choice!.destination);
                            completed = path.join(root, choice!.destination);
                            output.appendLine(`Publication completed: ${completed}`);
                            for (const warning of outcome.warnings) { output.appendLine(`Warning: ${warning}`); }
                            if (outcome.elapsedMs !== undefined) {
                                output.appendLine(`Publication finished in ${elapsedPublicationTime(outcome.elapsedMs)}`);
                            }
                        }
                    });
                } finally { forwarding.dispose(); }
            });
```

A validated outcome precedes cancellation state: a late cancellation cannot undo
commit. Authority is separate and is checked before remembering, offering an open
action and opening. If authority is revoked after commit, report the actual completed
output without claiming failure or taking further success actions. Failure
notifications are launched without awaiting user dismissal, so the command reaches
its cleanup and releases the publication guard immediately. PDFs open via
`vscode.open`, never as text documents.

```typescript: <<publication extension commands>>=+
            authority();
            if (series) {
                publishing = false;
                await vscode.window.showInformationMessage(`Exported ${series.publications.length} PDFs`);
            } else {
                await context.workspaceState.update(key, choice);
                authority();
                publishing = false;
                const action = await vscode.window.showInformationMessage(`Exported ${choice!.destination}`, 'Open Output');
                if (action === 'Open Output') {
                    authority();
                    await vscode.commands.executeCommand('vscode.open', vscode.Uri.file(path.join(root, choice!.destination)));
                }
            }
        } catch (error) {
            const detail = completed
                ? `Publication completed: ${completed}. ${message(error)} No further success actions will be taken.`
                : `Publication failed: ${message(error)}`;
            output.appendLine(detail);
            if (!disposed) {
                output.show(true);
                if (completed) { void vscode.window.showWarningMessage(detail.slice(0, 1500)); }
                else { void vscode.window.showErrorMessage(detail.slice(0, 1500)); }
            }
        } finally {
            operation.source.dispose();
            if (active === operation) { active = undefined; publishing = false; }
            if (disposed && !active) { output.dispose(); }
        }
    };
```

Registration disposal cancels the active operation and removes event and command
subscriptions immediately. The channel remains alive until the operation settles,
so helper results and cleanup diagnostics cannot write to a disposed channel.
Disposal does not release either guard early or force-kill the helper.

```typescript: <<publication extension commands>>=+
    const commands = ([['literate.exportLatex', 'latex'], ['literate.exportPdf', 'pdf']] as const)
        .map(([command, kind]) => vscode.commands.registerCommand(command, () => execute(kind)));
    context.subscriptions.push({ dispose(): void {
        if (disposed) { return; }
        disposed = true;
        foldersChanged.dispose();
        for (const command of commands) { command.dispose(); }
        active?.source.cancel();
        if (!active) { output.dispose(); }
    } });
}
```
