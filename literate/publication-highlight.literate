# Publication syntax without losing context

This chapter owns `src/publication-highlight.ts` and its headless tests. It does
not expand fragments: semantic references remain authored display text, with a
separate overlay for the LaTeX renderer. All offsets are half-open UTF-16 ranges
in the displayed text, not source coordinates or Unicode code-point counts.


## Display first, syntax second

Only literal segments decode escaped openers. Reference text remains unchanged,
including authored whitespace in the name. Accumulating display lengths maps
references after unescaping without rescanning them into accidental references.
The bridge normally rejects missing targets and modifiers; this API also rejects
them when called independently. Invalid segment reconstruction fails closed.

```ts : <<publication highlighting contract>>=
import hljs from 'highlight.js';
import type { PublicationContribution } from './engine';
import { syntaxColor } from './themes';
import type { LiterateTheme } from './themes';

export interface SyntaxSpan { start: number; end: number; scope: string; }
export interface HighlightedContribution {
    text: string;
    spans: SyntaxSpan[];
    references: { start: number; end: number; name: string; target: string }[];
}
```

Raw offsets are checked before display lengths are substituted. A reference with
an empty resolved target is just as unusable as an explicitly missing one.

```ts : <<publication highlighting display>>=
function displayContribution(part: PublicationContribution, screen: boolean): HighlightedContribution {
    const chunks: string[] = [];
    const references: HighlightedContribution['references'] = [];
    let rawOffset = 0, offset = 0;
    for (const segment of part.segments) {
        let text = segment.text;
        if (segment.kind === 'text') {
            text = text.replace(/\\\x3c\x3c/g, () => '<' + '<');
        } else {
            if (!screen && segment.modifier !== undefined) {
                throw new Error('Publication reference modifier is unsupported: ' + segment.name);
            }
            if (!screen && (segment.resolution.kind !== 'resolved' || !segment.resolution.target)) {
                throw new Error('Publication reference target is missing: ' + segment.name);
            }
            if (segment.start !== rawOffset || segment.end + (segment.modifier?.length || 0) !== rawOffset + text.length) {
                throw new Error('Publication reference offsets do not match segment text');
            }
```

Joining raw segments must recover the contribution; joining displayed segments
instead defines the new coordinate space. No syntax decision affects this map.

```ts : <<publication highlighting display>>=+
            if (segment.resolution.kind === 'resolved') {
                references.push({ start: offset, end: offset + text.length,
                    name: segment.name, target: segment.resolution.target });
            }
        }
        chunks.push(text);
        offset += text.length;
        rawOffset += segment.text.length;
    }
    if (part.segments.map(segment => segment.text).join('') !== part.content) {
        throw new Error('Publication segments do not reconstruct contribution content');
    }
    return { text: chunks.join(''), spans: [], references };
}
```

## A guarded private adapter

`out/publication-probe/highlighting/context-probe.cjs` and its README demonstrate
that splitting around references loses multiline comment and template context.
We highlight the displayed block once. We never parse highlighted HTML or CSS.
The installed highlight.js is 11.9.0; its private `_emitter.rootNode` contract is
version-gated, shape-checked, and checked for exact reconstruction. Upgrades must
explicitly revisit this adapter and its regression tests, not silently fall back.

```ts : <<publication highlighting emitter>>=
function record(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null;
}
function emitterRoot(text: string, language: string): unknown {
    if (hljs.versionString !== '11.9.0') {
        throw new Error('Publication highlighting requires highlight.js 11.9.0');
    }
    const result: unknown = hljs.highlight(text, { language, ignoreIllegals: true });
    if (!record(result) || !record(result._emitter) ||
        !record(result._emitter.rootNode)) {
        throw new Error('Unsupported highlight.js emitter shape');
    }
    return result._emitter.rootNode;
}
```

The traversal uses an explicit stack, not recursive JavaScript calls. Unscoped
nodes inherit the nearest token scope. Embedded `language:*` wrappers are not
semantic token scopes, so they do not overwrite that inheritance. A real nested
scope does overwrite it, including `subst` (plain text) and unknown scopes (the
CSS text reset). Dotted scope names are retained for consumers; styles use their
primary class. Empty text creates no zero-width span.

```ts : <<publication highlighting traversal>>=
function syntaxSpans(text: string, root: unknown): SyntaxSpan[] {
    const spans: SyntaxSpan[] = [];
    const chunks: string[] = [];
    const stack = [{ node: root, scope: '' }];
    const seen = new Set<object>();
    let offset = 0;
    while (stack.length) {
        const { node, scope } = stack.pop()!;
        if (typeof node === 'string') {
            if (node.length) {
                spans.push({ start: offset, end: offset + node.length, scope });
                chunks.push(node);
                offset += node.length;
            }
            continue;
        }
```

A repeated object is not a tree; rejecting it also prevents cycles from hanging
this adapter. Reconstruction compares characters, not merely lengths, so a
changed emitter cannot quietly return plausible but incorrect coordinates.

```ts : <<publication highlighting traversal>>=+
        if (!record(node) || !Array.isArray(node.children) ||
            (node.scope !== undefined && typeof node.scope !== 'string') || seen.has(node)) {
            throw new Error('Unsupported highlight.js emitter tree');
        }
        seen.add(node);
        const inherited = typeof node.scope === 'string' && node.scope &&
            !node.scope.startsWith('language:') ? node.scope : scope;
        for (let index = node.children.length - 1; index >= 0; index--) {
            stack.push({ node: node.children[index], scope: inherited });
        }
    }
    if (chunks.join('') !== text) {
        throw new Error('highlight.js emitter did not reconstruct publication text');
    }
    return spans;
}
```

Unknown or empty language names explicitly mean plain text. There is no automatic
language detection, and semantic references still work in plain blocks. Syntax
spans cover the entire nonempty display, including reference characters; the
renderer intersects these ranges and gives semantic references precedence.

```ts : <<publication highlighting entry>>=
export function highlightContribution(part: PublicationContribution, screen = false): HighlightedContribution {
    const display = displayContribution(part, screen);
    display.spans = part.language && hljs.getLanguage(part.language)
        ? syntaxSpans(display.text, emitterRoot(display.text, part.language))
        : display.text.length ? [{ start: 0, end: display.text.length, scope: '' }] : [];
    return display;
}
```

## Palette semantics, without a CSS parser

The pure `syntaxColor` lookup in `themes.literate` supplies the same scope colors
as standalone HTML and live preview CSS. Unknown scopes reset to text, and dotted
scopes use their base class. This adapter retains explicit publication typography:
keywords and variables are bold; literals remain purple without forced bold.
Comments, quotes and emphasis are italic, and strong is bold. Unlike screen CSS,
LaTeX syntax links are not underlined. No palette is remapped, including dark
palettes; this cleanup changes neither format's existing output styling.

```ts : <<publication highlighting styles>>=

export function syntaxStyle(scope: string, theme: LiterateTheme): {
    color: string; bold: boolean; italic: boolean;
} {
    const base = scope.split('.')[0];
    return { color: syntaxColor(scope, theme),
        bold: ['keyword', 'variable', 'template-variable', 'strong'].includes(base),
        italic: ['comment', 'quote', 'emphasis'].includes(base) };
}
```

## Headless contract tests

The contract tests pass their fixtures through the real publication parser so
escapes and raw UTF-16 offsets have the same meaning as they do in the renderer.
They also verify that independently generated test output uses normal imports.

Construct delimiters at runtime so the tests themselves do not introduce literate
fragment dependencies. Each fixture includes one resolved family named `piece`.

```ts : <<publication highlighting test setup>>=
import assert = require('node:assert/strict');
import { test } from 'node:test';
import hljs from 'highlight.js';
import { parseProject } from '../../engine';
import { themes, syntaxColor, themeCss } from '../../themes';
import { renderLatex } from '../../publication-latex';
import type { PandocBlock } from '../../publication-pandoc';
import { createHash } from 'node:crypto';
import { highlightContribution, syntaxStyle } from '../../publication-highlight';
const tag = (name: string) => '<' + '<' + name + '>>';
function part(body: string, language = 'javascript') {
    const fence = (header: string, content: string) => '```' + header + '\n' + content + '\n```\n';
    const result = parseProject([{ path: 'index.literate', text:
        fence(language + ': ' + tag('main') + '=', body) + fence(': ' + tag('piece') + '=', 'x') }]);
    assert.deepEqual(result.diagnostics, []);
    return result.publication.contributions[0];
}
function scopeAt(result: ReturnType<typeof highlightContribution>, marker: string): string {
    const offset = result.text.indexOf(marker);
    assert.ok(offset >= 0);
    return result.spans.find(span => span.start <= offset && offset < span.end)!.scope;
}
```

Both positive cases deliberately retain text after a reference inside an open
lexical construct. The split-block negative controls prove that these fixtures
actually detect loss of context, rather than merely exercising the API.

```ts : <<publication highlighting context tests>>=
test('whole-block highlighting preserves comment and template context around references', () => {
    const cases = [
        { body: '/* before\n' + tag('piece') + '\nCOMMENT_AFTER\n*/\nconst ready = true;',
            marker: 'COMMENT_AFTER', scope: 'comment' },
        { body: 'const message = `before\n' + tag('piece') + '\nTEMPLATE_AFTER ${count + 1}`;',
            marker: 'TEMPLATE_AFTER', scope: 'string' }
    ];
    for (const fixture of cases) {
        const result = highlightContribution(part(fixture.body));
        assert.equal(scopeAt(result, fixture.marker), fixture.scope);
        assert.equal(result.references.length, 1);
        const suffix = result.text.slice(result.references[0].end);
        assert.notEqual(scopeAt(highlightContribution(part(suffix)), fixture.marker), fixture.scope);
        assert.equal(scopeAt(result, 'const'), 'keyword');
    }
});
```

An escaped opener before an emoji and two repeated references tests the new
coordinate space. Escaped references remain literal even though the displayed
text now looks like a reference. Raw contribution data must not be mutated.

```ts : <<publication highlighting display tests>>=
test('literal unescape maps repeated references after emoji in UTF-16', () => {
    const input = part('\\' + tag('literal') + ' 😀 ' + tag('piece') + '/' + tag('piece'), 'unknown-language');
    const snapshot = JSON.stringify(input);
    const result = highlightContribution(input);
    assert.equal(result.text, tag('literal') + ' 😀 ' + tag('piece') + '/' + tag('piece') + '\n');
    assert.equal(result.references.length, 2);
    assert.equal(result.references[0].start, tag('literal').length + 4);
    for (const ref of result.references) {
        assert.equal(result.text.slice(ref.start, ref.end), tag('piece'));
        assert.equal(ref.name, 'piece');
        assert.ok(ref.target);
    }
    assert.deepEqual(result.spans, [{ start: 0, end: result.text.length, scope: '' }]);
    assert.equal(JSON.stringify(input), snapshot);
});
```

Standalone callers receive errors for unsupported graph state rather than a
visually plausible output with broken links. Plain and empty blocks are explicit.

```ts : <<publication highlighting display tests>>=+
test('standalone validation rejects missing references, modifiers and invalid segments', () => {
    assert.throws(() => highlightContribution(part(tag('missing'))), /target is missing/);
    assert.throws(() => highlightContribution(part(tag('piece') + '=+')), /modifier/);
    const input = part(tag('piece'));
    input.content += 'bad';
    assert.throws(() => highlightContribution(input), /reconstruct/);
    const invalid = part(tag('piece'));
    const ref = invalid.segments.find(segment => segment.kind === 'reference')!;
    if (ref.kind === 'reference') { ref.start++; }
    assert.throws(() => highlightContribution(invalid), /offsets/);
    const empty = part('', '');
    empty.content = ''; empty.segments = [];
    assert.deepEqual(highlightContribution(empty), { text: '', spans: [], references: [] });
});
```

Embedded JavaScript inside HTML exercises real language containers and nested
substitution nodes. Every emitted range is contiguous and exactly reconstructs
the display; substitution punctuation must not inherit string coloring.

```ts : <<publication highlighting grammar tests>>=
test('embedded grammar and nested scopes reconstruct exact display', () => {
    const result = highlightContribution(part(
        '<script>const message = `hello ${count + 1}`; function work() { return true; }</script>', 'xml'));
    let offset = 0;
    for (const span of result.spans) {
        assert.equal(span.start, offset);
        assert.ok(span.end > span.start);
        offset = span.end;
    }
    assert.equal(offset, result.text.length);
    assert.equal(result.spans.map(span => result.text.slice(span.start, span.end)).join(''), result.text);
    assert.equal(scopeAt(result, 'const'), 'keyword');
    assert.equal(scopeAt(result, 'hello'), 'string');
    assert.equal(scopeAt(result, 'count'), 'subst');
    assert.equal(scopeAt(result, 'work'), 'title.function');
    assert.equal(syntaxStyle(scopeAt(result, 'work'), themes[0]).color, themes[0].colors.information);
});
```

A synchronous mock isolates the private adapter from highlight.js's own recursive
HTML emitter. The adapter itself must handle deep trees iteratively, inherit
through neutral wrappers, reject bad shapes and cycles, and compare characters.
Every mutation is restored even when an assertion fails.

```ts : <<publication highlighting guard tests>>=
function withEmitter(root: unknown, run: () => void): void {
    const original = hljs.highlight;
    hljs.highlight = (() => ({ _emitter: { rootNode: root } })) as unknown as typeof hljs.highlight;
    try { run(); } finally { hljs.highlight = original; }
}
test('private adapter inherits scopes without recursive traversal', () => {
    let root: unknown = 'x\n';
    for (let depth = 0; depth < 20000; depth++) { root = { children: [root] }; }
    root = { scope: 'comment', children: [{ scope: 'language:javascript', children: [root] }] };
    withEmitter(root, () => {
        assert.deepEqual(highlightContribution(part('x')).spans, [{ start: 0, end: 2, scope: 'comment' }]);
    });
});
```

These are hard failures, not plain-text fallbacks. A future library upgrade must
satisfy the version gate as well as tree and reconstruction requirements.

```ts : <<publication highlighting guard tests>>=+
test('private adapter guards version, shape, cycles and exact reconstruction', () => {
    const version = hljs.versionString;
    hljs.versionString = '99.0.0';
    try { assert.throws(() => highlightContribution(part('x')), /11\.9\.0/); }
    finally { hljs.versionString = version; }
    for (const root of [null, {}, { children: [42] }, { scope: 1, children: [] }]) {
        withEmitter(root, () => assert.throws(() => highlightContribution(part('x')), /emitter/));
    }
    const cycle: { children: unknown[] } = { children: [] };
    cycle.children.push(cycle);
    withEmitter(cycle, () => assert.throws(() => highlightContribution(part('x')), /tree/));
    withEmitter({ children: ['y\n'] }, () => {
        assert.throws(() => highlightContribution(part('x')), /reconstruct/);
    });
});
```

All seventy palettes are checked without consulting CSS at runtime. The groups
below are independent expectations for every mapped token family, including
plain resets and dotted forms; weights do not accidentally make booleans bold.

```ts : <<publication highlighting palette tests>>=
const groups = {
    purple: 'keyword selector-tag literal', accent: 'string regexp addition',
    warning: 'number symbol bullet', information: 'title section built_in type link',
    cyan: 'attr attribute variable template-variable', muted: 'comment quote',
    yellow: 'meta doctag', danger: 'deletion name',
    text: 'subst unknown emphasis strong constructor __proto__ toString params property operator punctuation'
};
```

These expectations remain independent of the shared implementation, including
unmapped highlight.js families and prototype keys.

```ts : <<publication highlighting palette tests>>=+
test('all 70 palettes retain exact scope colors and publication font policy', () => {
    assert.equal(themes.length, 70);
    for (const theme of themes) {
        for (const [key, scopes] of Object.entries(groups)) {
            for (const scope of scopes.split(' ')) {
                const expected = { color: theme.colors[key as keyof typeof theme.colors],
                    bold: ['keyword', 'variable', 'template-variable', 'strong'].includes(scope),
                    italic: ['comment', 'quote', 'emphasis'].includes(scope) };
                assert.match(expected.color, /^#[0-9a-f]{6}$/i);
                assert.equal(syntaxColor(scope, theme), expected.color);
                assert.equal(syntaxColor(scope + '.nested', theme), expected.color);
                assert.deepEqual(syntaxStyle(scope, theme), expected);
                assert.deepEqual(syntaxStyle(scope + '.nested', theme), expected);
            }
        }
        assert.equal(syntaxColor('', theme), theme.colors.text);
        assert.deepEqual(syntaxStyle('', theme), { color: theme.colors.text, bold: false, italic: false });
    }
});
```

Screen rules are checked independently of the lookup, including unmapped resets.
The hash was captured before extraction from all seventy complete stylesheets;
it pins selector order, whitespace, decorations and all non-syntax styling too.

```ts : <<publication highlighting CSS tests>>=
test('all screen CSS bytes remain unchanged after scope extraction', () => {
    const css = themes.map(theme => themeCss(theme)).join('\n');
    assert.equal(createHash('sha256').update(css).digest('hex'),
        '51ec8b26a6cd75ce6d62c664370f08dd291ca17168eed60083c6092a74bbbd32');
});
function screenStyle(css: string, scope: string): string {
    let declarations = '';
    for (const rule of css.matchAll(/([^{}]+)\{([^{}]*)\}/g)) {
        const selectors = rule[1].trim().split(', ');
        if (selectors.includes('.literate-document [class*="hljs-"]') ||
            selectors.includes('.literate-document .hljs-' + scope)) {
            declarations += rule[2];
        }
    }
    return declarations;
}
```

This small rule reader is test-only, not a runtime CSS parser. It models the flat
base selectors emitted here, not arbitrary browser cascade or host typography.
Screen keyword/variable weight inheritance intentionally remains untouched.

```ts : <<publication highlighting CSS tests>>=+
test('screen scope colors and format-specific decorations cover every palette', () => {
    for (const theme of themes) {
        const css = themeCss(theme);
        for (const [key, scopes] of Object.entries(groups)) {
            for (const scope of scopes.split(' ')) {
                const style = screenStyle(css, scope);
                const colors = [...style.matchAll(/color: var\(--literate-(\w+)\)/g)];
                assert.equal(colors[colors.length - 1][1], key, scope);
                assert.equal(style.includes('font-style: italic;'),
                    ['comment', 'quote', 'emphasis'].includes(scope), scope);
                assert.equal(style.includes('font-weight: bold;'), scope === 'strong', scope);
                assert.equal(style.includes('text-decoration: underline;'), scope === 'link', scope);
            }
        }
    }
});
```

Inject a complete emitter tree to exercise every scope through the real LaTeX
renderer, rather than depending on a grammar to emit all possible families.
Newlines keep identical adjacent styles independently assertable after merging.
Both dotted and base scopes must produce the approved color/weight/italic macros.

```ts : <<publication highlighting output tests>>=
function rawStyles(blocks: PandocBlock[]): string {
    return blocks.map(block => block.t === 'RawBlock' ? block.c[1]
        : block.t === 'Div' ? rawStyles(block.c[1]) : '').join('\n');
}
```

The publication bridge wraps chapters in Divs; retain their trusted raw blocks
in the test converter just as Pandoc does.

```ts : <<publication highlighting output tests>>=+
test('LaTeX emits every scope with unchanged typography in all themes', async () => {
    const scopes = Object.values(groups).flatMap(value => value.split(' '))
        .flatMap(scope => [scope, scope + '.nested']).concat('');
    const text = scopes.map((_, index) => 'token' + index + '\n').join('');
    const input = '```javascript: ' + tag('styles') + '=\n' + text + '```\n';
    const project = parseProject([{ path: 'index.literate', text: input }]);
    assert.deepEqual(project.diagnostics, []);
    const original = hljs.highlight;
    hljs.highlight = (() => ({ _emitter: { rootNode: { children: scopes.map((scope, index) =>
        ({ scope, children: ['token' + index + '\n'] })) } } })) as unknown as typeof hljs.highlight;
    try {
        for (const theme of themes) {
            const result = await renderLatex(project, { theme: theme.name }, async document =>
                rawStyles(document.blocks));
            assert.deepEqual(result.diagnostics, []);
            <<publication highlighting macro assertions>>
        }
    } finally { hljs.highlight = original; }
});
```

Expected macros are derived from independent test groups, not `syntaxStyle`.
No syntax underline command should appear, even for the link scope.

```ts : <<publication highlighting macro assertions>>=
scopes.forEach((scope, index) => {
    const base = scope.split('.')[0];
    const key = Object.entries(groups).find(([, names]) => names.split(' ').includes(base))?.[0] || 'text';
    const hex = theme.colors[key as keyof typeof theme.colors].slice(1);
    const bold = ['keyword', 'variable', 'template-variable', 'strong'].includes(base) ? '\\bfseries' : '';
    const italic = ['comment', 'quote', 'emphasis'].includes(base) ? '\\itshape' : '';
    assert.ok(result.latex?.includes(`\\LitStyle{${hex}}{${bold}}{${italic}}{token${index}}`),
        theme.name + ': ' + scope);
});
assert.doesNotMatch(result.latex!, /\\(?:underline|uline)\{/);
```
