    const only = context.only?.value;
    if (only !== undefined && !/^[\w.-]{1,256}$/.test(only)) { return; }
    return { range: mapped, context: { diagnostics, ...(only === undefined ? {} : { only: [only] }), triggerKind: 1 } };
}
