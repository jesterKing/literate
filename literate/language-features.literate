Hover text is bounded and explicitly untrusted, including legacy marked strings.
Explicit unsafe hover ranges discard the hover. Completion resolution shares this
Markdown boundary and copies only documentation/detail, never replacement edits
or commands. Signature labels and parameter offsets are validated separately.

```ts : <<language feature hover text>>=
function hoverText(value: unknown): vscode.MarkdownString | undefined {
    const markdown = new vscode.MarkdownString();
    markdown.isTrusted = false;
    markdown.supportHtml = false;
    if (typeof value === 'string') { markdown.appendMarkdown(value.slice(0, 8192)); }
    else if (object(value) && typeof value.value === 'string') {
        const text = value.value.slice(0, 8192);
        if (value.kind === 'plaintext') { markdown.appendText(text); }
        else if (value.kind === 'markdown') { markdown.appendMarkdown(text); }
        else if (typeof value.language === 'string' && /^[\w+-]{1,40}$/.test(value.language)) {
            markdown.appendCodeblock(text, value.language);
        } else { return undefined; }
    } else { return undefined; }
    return markdown.value ? markdown : undefined;
}
```

```ts : <<language feature hover result>>=
function hover(view: RequestView, reply: unknown): vscode.Hover | undefined {
    if (!object(reply)) { return undefined; }
    const values = Array.isArray(reply.contents) ? reply.contents.slice(0, 8) : [reply.contents];
    const contents = values.map(hoverText).filter((value): value is vscode.MarkdownString => !!value);
    if (!contents.length) { return undefined; }
    const range = reply.range === undefined ? wordRange(view) : mappedRange(view, reply.range);
    if (!range) { return undefined; }
    return new vscode.Hover(contents, range);
}
function signature(reply: unknown): vscode.SignatureHelp | undefined {
    if (!object(reply) || !Array.isArray(reply.signatures) || !reply.signatures.length || reply.signatures.length > 100) { return; }
    const result = new vscode.SignatureHelp();
    for (const raw of reply.signatures) {
        if (!object(raw) || typeof raw.label !== 'string' || raw.label.length > 8192) { return; }
        const info = new vscode.SignatureInformation(raw.label, hoverText(raw.documentation));
        if (raw.parameters !== undefined && (!Array.isArray(raw.parameters) || raw.parameters.length > 100)) { return; }
        for (const parameter of (raw.parameters || []) as unknown[]) {
            if (!object(parameter)) { return; }
            const label = parameter.label;
            if (typeof label === 'string') {
                if (!raw.label.includes(label)) { return; }
            } else if (!Array.isArray(label) || label.length !== 2 || !label.every(Number.isSafeInteger)
                || label[0] < 0 || label[1] < label[0] || label[1] > raw.label.length) { return; }
            info.parameters.push(new vscode.ParameterInformation(label as string | [number, number], hoverText(parameter.documentation)));
        }
        if (raw.activeParameter !== undefined) { info.activeParameter = boundedIndex(raw.activeParameter, info.parameters.length); }
        result.signatures.push(info);
    }
```

