## Keep authority outside the project

Executable configuration never uses a merged getter. The resource-scoped
`automaticCompletion` boolean is separate and defaults to true. Invalid entries receive a fixed diagnostic;
aliases normalize fence labels, not configuration keys. Omitted arguments mean an
empty array. Executables run without a shell through the existing client. Output
never includes configuration values, source, protocol errors or stderr.

```ts : <<language feature imports>>=
import * as vscode from 'vscode';
import * as path from 'node:path';
import { parseProject, parseFragmentHeader, scanFragmentTags, SourceDocument } from './engine';
import { LanguageClient } from './language-client';
import { mapGeneratedRange, mapSourcePosition, projectLanguageSources, SourceProjectionPosition } from './language-projection';

type ObjectValue = Record<string, unknown>;
const object = (value: unknown): value is ObjectValue => value !== null && typeof value === 'object' && !Array.isArray(value);
const aliases: Record<string, string> = { ts: 'typescript', js: 'javascript', tsx: 'typescriptreact', jsx: 'javascriptreact',
    // eslint-disable-next-line @typescript-eslint/naming-convention
    py: 'python', rb: 'ruby', sh: 'shellscript', bash: 'shellscript', yml: 'yaml', cs: 'csharp', 'c++': 'cpp', rs: 'rust' };
const language = (value: string): string => Object.prototype.hasOwnProperty.call(aliases, value.toLowerCase())
    ? aliases[value.toLowerCase()] : value.toLowerCase();
const family = (value: string): boolean => ['typescript', 'javascript', 'typescriptreact', 'javascriptreact'].includes(value);
interface Server { command: string; args: string[]; initializationOptions?: ObjectValue; configuration?: ObjectValue; }
interface RequestView { document: vscode.TextDocument; position: vscode.Position; hit: SourceProjectionPosition; }
export interface LanguageSnapshot { documents: SourceDocument[]; templates: Record<string, string>; }
```

```ts : <<language feature settings>>=
function servers(invalid: () => void = () => undefined): Record<string, Server> {
    const raw = vscode.workspace.getConfiguration('literate').inspect<unknown>('languageServers')?.globalValue;
    const result: Record<string, Server> = Object.create(null);
    if (!object(raw)) { if (raw !== undefined) { invalid(); } return result; }
    for (const [id, entry] of Object.entries(raw)) {
        if (!/^[a-z][a-z0-9+-]*$/.test(id) || language(id) !== id || !object(entry)
            || typeof entry.command !== 'string' || !path.isAbsolute(entry.command) || entry.command.includes('\0')
            || (entry.args !== undefined && (!Array.isArray(entry.args)
                || !entry.args.every(arg => typeof arg === 'string' && !arg.includes('\0'))))
            || (entry.initializationOptions !== undefined && !object(entry.initializationOptions))
            || (entry.configuration !== undefined && !object(entry.configuration))) { invalid(); continue; }
        result[id] = { command: entry.command, args: entry.args === undefined ? [] : [...entry.args as string[]],
            initializationOptions: entry.initializationOptions as ObjectValue | undefined,
            configuration: entry.configuration as ObjectValue | undefined };
    }
    return result;
}
function local(folder: vscode.WorkspaceFolder, document: vscode.TextDocument): boolean {
    return vscode.workspace.isTrusted && !vscode.env.remoteName && folder.uri.scheme === 'file' && !folder.uri.authority
        && document.uri.scheme === 'file' && !document.uri.authority && !document.isClosed
        && document.languageId === 'markdown' && document.uri.fsPath.endsWith('.literate')
        && !!vscode.workspace.workspaceFolders?.includes(folder)
        && vscode.workspace.getWorkspaceFolder(document.uri) === folder;
}
```

A single-buffer parse scopes Escape immediately, without disk capture or graph
expansion. Token maps and the shared header parser exclude prose and fence lines;
reference spans and unfinished markers are excluded too. This proves only a local
body, never a generated mapping: requests still require full snapshot projection.

```ts : <<language feature local body>>=
function localBody(document: vscode.TextDocument, cursor: vscode.Position): boolean {
    try {
        const text = document.getText(), lines = text.split(/\r\n|\r|\n/);
        const parsed = parseProject([{ path: 'input.literate', text }]);
        const token = parsed.documents[0]?.tokens.find(value => value.type === 'fence' && value.map
            && cursor.line > value.map[0] && cursor.line < value.map[1]);
        if (!token?.map) { return false; }
        const header = parseFragmentHeader(token.info);
        if (!header || (header.language && !servers()[language(header.language)])) { return false; }
        const bodyLines = token.content.split('\n'), index = cursor.line - token.map[0] - 1;
        if (index >= bodyLines.length - (token.content.endsWith('\n') ? 1 : 0)) { return false; }
        const body = bodyLines[index], column = cursor.character - (lines[cursor.line].length - body.length);
        if (column <= 0 || column > body.length) { return false; }
        const before = body.slice(0, column - 1) + body.slice(column);
        if (before.trim().startsWith(token.markup)) { return false; }
        if (scanFragmentTags(body).some(tag => column >= tag.start && column <= tag.end + (tag.modifier?.length ?? 0))) {
            return false;
        }
        const prefix = body.slice(0, column);
        return prefix.lastIndexOf('<<') <= prefix.lastIndexOf('>>');
    } catch { return false; }
}
```

## Treat replies as untrusted data

Positions use UTF-16 indexes and reject out-of-line coordinates rather than
clamping them. Every edit must stay in the original occurrence, on the cursor's
line, and contain the cursor. Unsupported completion defaults reject the list;
commands, snippets and auxiliary edits reject the item, never becoming plaintext.

```ts : <<language feature error categories>>=
function errorCategory(error: unknown): string {
    const code = object(error) ? error.code : undefined;
    if (code === 'ENOENT') { return 'ENOENT (executable, working directory or input file not found)'; }
    if (code === 'EACCES' || code === 'EPERM') { return 'permission denied (check executable and input permissions)'; }
    if (code === 'EPIPE' || code === 'ECONNRESET') { return 'server transport closed'; }
    const message = error instanceof Error ? error.message : '';
    if (code === 'ETIMEDOUT' || /^LSP request timed out:/.test(message)) { return 'request timeout (server did not respond)'; }
    if (/^Language server (exited|stdout closed)/.test(message)) { return 'server exited or closed stdout'; }
    if (/^Language server (document synchronization unsupported|open\/close synchronization required)/.test(message)) {
        return 'server lacks required document synchronization';
    }
    if (message === 'Language server must use UTF-16 positions') { return 'unsupported position encoding (UTF-16 required)'; }
    if (/^Invalid (LSP|JSON-RPC|initialize result)/.test(message)) { return 'invalid server protocol response'; }
    if (/^LSP .*limit exceeded/.test(message)) { return 'protocol resource limit exceeded'; }
    if (typeof code === 'number') { return 'server returned a protocol error'; }
    return 'unclassified failure (raw error omitted for privacy)';
}
```

```ts : <<language feature projection reasons>>=
function projectionReason(message: string): string {
    if (message.startsWith('Missing template:')) { return 'missing template; check template paths and captured template inputs.'; }
    if (message.startsWith('Missing fragment:') || message.startsWith('Cannot append to missing fragment:')) {
        return 'missing fragment; define the referenced fragment or correct its name.';
    }
    if (message.startsWith('Fragment cycle:')) { return 'fragment cycle; remove recursive references.'; }
    if (message.startsWith('Duplicate fragment:')) { return 'duplicate fragment; use append syntax for additional definitions.'; }
    if (/^Invalid (fragment header|fragment setting|template path)/.test(message)) {
        return 'invalid fragment header, setting or template path; check fence syntax and relative template paths.';
    }
    if (message.includes('limit exceeded')) { return 'expansion limit exceeded; reduce repeated fragment/template expansion.'; }
    return 'invalid project graph or inputs; check fragment definitions, references and output paths.';
}
```

```ts : <<language feature positions>>=
function offset(text: string, value: unknown): number | undefined {
    if (!object(value) || !Number.isSafeInteger(value.line) || !Number.isSafeInteger(value.character)
        || (value.line as number) < 0 || (value.character as number) < 0) { return undefined; }
    const lines = text.split(/\r\n|\r|\n/);
    const line = value.line as number, character = value.character as number;
    if (line >= lines.length || character > lines[line].length) { return undefined; }
    let start = 0, index = 0;
    for (const match of text.matchAll(/\r\n|\r|\n/g)) {
        if (index++ === line) { break; }
        start = match.index! + match[0].length;
    }
    return start + character;
}
function position(text: string, at: number): { line: number; character: number } {
    const lines = text.slice(0, at).split(/\r\n|\r|\n/);
    return { line: lines.length - 1, character: lines[lines.length - 1].length };
}
```

```ts : <<language feature ranges>>=
function mappedRange(view: RequestView, value: unknown): vscode.Range | undefined {
    if (!object(value)) { return undefined; }
    const { file, mapping } = view.hit;
    const start = offset(file.content, value.start), end = offset(file.content, value.end);
    if (start === undefined || end === undefined) { return undefined; }
    const mapped = mapGeneratedRange(file, start, end, mapping);
    if (!mapped) { return undefined; }
    const range = new vscode.Range(view.document.positionAt(mapped.start), view.document.positionAt(mapped.end));
    return range.start.line === range.end.line && range.start.line === view.position.line && range.contains(view.position)
        ? range : undefined;
}
```

A default edit uses the source word, not the whole prefix preceding the cursor.
The explicit identifier expression excludes dots even under Markdown word rules.
An absent or unsafe word becomes a zero-width insertion inside the active mapping.

```ts : <<language feature words>>=
function wordRange(view: RequestView): vscode.Range {
    const { document, position: cursor, hit } = view;
    const word = document.getWordRangeAtPosition(cursor, /[\p{L}\p{N}_$]+/u);
    if (word && word.start.line === cursor.line && word.end.line === cursor.line && word.contains(cursor)
        && document.offsetAt(word.start) >= hit.mapping.sourceStart
        && document.offsetAt(word.end) <= hit.mapping.sourceEnd) { return word; }
    return new vscode.Range(cursor, cursor);
}
function completions(view: RequestView, reply: unknown): vscode.CompletionItem[] | undefined {
    if (object(reply) && ('itemDefaults' in reply || 'editDefaults' in reply)) { return undefined; }
    const items = Array.isArray(reply) ? reply : object(reply) && Array.isArray(reply.items) ? reply.items : undefined;
    return items?.slice(0, 1000).flatMap(value => {
        const item = completion(view, value);
        return item ? [item] : [];
    });
}
```

```ts : <<language feature completion guard>>=
function completion(view: RequestView, value: unknown): vscode.CompletionItem | undefined {
    if (!object(value) || typeof value.label !== 'string' || !value.label.length || value.label.length > 4096
        || 'command' in value || 'editDefaults' in value || 'textEditText' in value || value.kind === 15
        || (value.insertTextFormat !== undefined && value.insertTextFormat !== 1)
        || (value.insertTextMode !== undefined && value.insertTextMode !== 1)
        || (value.additionalTextEdits !== undefined && (!Array.isArray(value.additionalTextEdits) || value.additionalTextEdits.length))
        || (value.insertText !== undefined && typeof value.insertText !== 'string')) { return undefined; }
    const item = new vscode.CompletionItem(value.label);
    let text = typeof value.insertText === 'string' ? value.insertText : value.label;
    item.range = wordRange(view);
```

```ts : <<language feature completion edits>>=
    if (value.textEdit !== undefined) {
        const edit = value.textEdit;
        if (!object(edit) || typeof edit.newText !== 'string') { return undefined; }
        text = edit.newText;
        if ('range' in edit) {
            if ('insert' in edit || 'replace' in edit) { return undefined; }
            const range = mappedRange(view, edit.range);
            if (!range) { return undefined; }
            item.range = range;
        } else {
            const inserting = mappedRange(view, edit.insert), replacing = mappedRange(view, edit.replace);
            if (!inserting || !replacing || !inserting.start.isEqual(replacing.start)
                || !replacing.contains(inserting)) { return undefined; }
            item.range = { inserting, replacing };
        }
    }
    if (text.length > 65536) { return undefined; }
    item.insertText = text;
```

```ts : <<language feature completion metadata>>=
    for (const key of ['sortText', 'filterText', 'detail'] as const) {
        const text = value[key];
        if (typeof text === 'string') { item[key] = text.slice(0, 4096); }
    }
    const kinds = [vscode.CompletionItemKind.Text, vscode.CompletionItemKind.Method, vscode.CompletionItemKind.Function,
        vscode.CompletionItemKind.Constructor, vscode.CompletionItemKind.Field, vscode.CompletionItemKind.Variable,
        vscode.CompletionItemKind.Class, vscode.CompletionItemKind.Interface, vscode.CompletionItemKind.Module,
        vscode.CompletionItemKind.Property, vscode.CompletionItemKind.Unit, vscode.CompletionItemKind.Value,
        vscode.CompletionItemKind.Enum, vscode.CompletionItemKind.Keyword, vscode.CompletionItemKind.Snippet,
        vscode.CompletionItemKind.Color, vscode.CompletionItemKind.File, vscode.CompletionItemKind.Reference,
        vscode.CompletionItemKind.Folder, vscode.CompletionItemKind.EnumMember, vscode.CompletionItemKind.Constant,
        vscode.CompletionItemKind.Struct, vscode.CompletionItemKind.Event, vscode.CompletionItemKind.Operator,
        vscode.CompletionItemKind.TypeParameter];
    if (Number.isInteger(value.kind) && (value.kind as number) >= 1 && (value.kind as number) <= kinds.length) {
        item.kind = kinds[(value.kind as number) - 1];
    }
    return item;
}
```

Hover text is bounded and explicitly untrusted, including legacy marked strings.
Explicit unsafe hover ranges discard the hover. There is no completion resolution,
server command forwarding, diagnostics publication or automatic trigger support.

```ts : <<language feature hover text>>=
function hoverText(value: unknown): vscode.MarkdownString | undefined {
    const markdown = new vscode.MarkdownString();
    markdown.isTrusted = false;
    markdown.supportHtml = false;
    if (typeof value === 'string') { markdown.appendMarkdown(value.slice(0, 8192)); }
    else if (object(value) && typeof value.value === 'string') {
        const text = value.value.slice(0, 8192);
        if (value.kind === 'plaintext') { markdown.appendText(text); }
        else if (value.kind === 'markdown') { markdown.appendMarkdown(text); }
        else if (typeof value.language === 'string' && /^[\w+-]{1,40}$/.test(value.language)) {
            markdown.appendCodeblock(text, value.language);
        } else { return undefined; }
    } else { return undefined; }
    return markdown.value ? markdown : undefined;
}
```

```ts : <<language feature hover result>>=
function hover(view: RequestView, reply: unknown): vscode.Hover | undefined {
    if (!object(reply)) { return undefined; }
    const values = Array.isArray(reply.contents) ? reply.contents.slice(0, 8) : [reply.contents];
    const contents = values.map(hoverText).filter((value): value is vscode.MarkdownString => !!value);
    if (!contents.length) { return undefined; }
    const range = reply.range === undefined ? wordRange(view) : mappedRange(view, reply.range);
    if (!range) { return undefined; }
    return new vscode.Hover(contents, range);
}
```

## One operation, no waiting queue

Dropping overlapping requests bounds both snapshot work and protocol pressure.
The operation owns initialization, full synchronization and its reply as one unit.
Every asynchronous boundary checks document version, the global revision epoch,
folder membership, trust, configuration and cancellation. Disk events invalidate
literate inputs and captured template paths. Paths changing during capture are
bounded and checked against the completed template input set. Non-input changes,
including publication outputs and transaction files, do not cancel cold startup.
New source files always invalidate; missing templates cannot yield suggestions.

```ts : <<language feature lifecycle>>=
export function registerLanguageFeatures(context: vscode.ExtensionContext,
    snapshot: (folder: vscode.WorkspaceFolder) => Promise<LanguageSnapshot>): void {
    type Session = { client: LanguageClient; failed: boolean; started?: boolean };
    const sessions = new Map<string, Session>();
    let epoch = 0, busy = false, disposed = false;
    let active: AbortController | undefined;
    const invalidate = (): void => { epoch++; active?.abort(); cancelAutomatic(); };
    const close = (client: LanguageClient): void => { void client.dispose().catch(() => undefined); };
    let invalidReported = false, capturing = false;
    const captureChanges = new Set<string>();
    const templatePaths = new Map<string, Set<string>>(), reported = new Set<string>();
    const reset = (): void => {
        invalidate(); sessions.forEach(session => { if (!session.failed) { close(session.client); } });
        sessions.clear(); templatePaths.clear(); reported.clear(); invalidReported = false;
    };
    context.subscriptions.push({ dispose() { disposed = true; reset(); } });
```

Failure disables that session until configuration changes or the user invokes
`literate.restartLanguageServers`. Cancellation is not failure. Restart invalidates
old work without releasing the serialization gate until it settles. Diagnostics
are fixed, actionable messages, once per failed session or invalid configuration
revision, with at most 100 retained lines. No automatic restart loop is possible.

```ts : <<language feature diagnostics>>=
    const output = vscode.window.createOutputChannel('Literate Language Servers');
    let lines = 0;
    const report = (message: string): void => {
        if (disposed) { return; }
        if (lines >= 100) { output.clear(); lines = 0; }
        output.appendLine(message); lines++;
    };
    const reportOnce = (message: string): void => {
        if (!reported.has(message)) { reported.add(message); report(message); }
    };
    const invalid = (): void => {
        if (invalidReported) { return; }
        invalidReported = true;
        report('Invalid global literate.languageServers: use canonical language IDs, an absolute executable command, '
            + 'optional string-array args and object initializationOptions/configuration. Workspace overrides are ignored.');
    };
    context.subscriptions.push(output, vscode.commands.registerCommand('literate.restartLanguageServers', () => {
        if (!disposed) { reset(); }
    }));
```

## Debounce only the latest focused insertion

One candidate survives a busy initialization or hover, without a request queue.
Its version, cursor, editor and epoch must still agree after every asynchronous
boundary. The insertion's own keyboard selection event is acknowledged once;
other selection events cancel. The parent owns the default-true resource boolean
and an Escape binding for `literate.cancelAutomaticCompletion`, guarded exactly by
`editorTextFocus && literate.automaticCompletionPending && !suggestWidgetVisible && !findWidgetVisible && !renameInputVisible && !inSnippetMode`.
The command only cancels pending work; normal widget Escape remains untouched.
The context starts synchronously after local body verification, before debounce,
and clears before showing results. Every eligible edit rechecks local Markdown;
selection moves cancel. The asynchronous setContext delivery has no added wait.
No public event observes raw Escape. Text change events do not identify the originating
command: a one-character paste is indistinguishable from typing. Multi-character
paste, replacements, undo/redo and multi-cursor edits are rejected.

```ts : <<language feature automatic state>>=
    type Edit = { editor: vscode.TextEditor; document: vscode.TextDocument; cursor: vscode.Position;
        version: number; revision: number; character: string; selectionSeen: boolean; body: boolean };
    let candidate: Edit | undefined, pending: Edit | undefined;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let cached: { edit: Edit; items: vscode.CompletionItem[] } | undefined;
    function cancelAutomatic(keepContext = false): void {
        if (timer) { clearTimeout(timer); timer = undefined; }
        candidate = pending = undefined; cached = undefined;
        if (!keepContext) { setPending(false); }
    }
    function enabled(document: vscode.TextDocument): boolean {
        const folder = vscode.workspace.getWorkspaceFolder(document.uri);
        return !!folder && local(folder, document)
            && vscode.workspace.getConfiguration('literate', document.uri).get<boolean>('automaticCompletion', true);
    }
```

Context writes are issued in transition order, without awaiting or installing
state-changing promise callbacks. An old drain may only clear its own candidate;
its completion cannot clear the latest candidate's context or debounce timer.

```ts : <<language feature automatic context>>=
    let pendingContext: boolean | undefined;
    function setPending(value: boolean): void {
        if (pendingContext === value) { return; }
        pendingContext = value;
        void vscode.commands.executeCommand('setContext', 'literate.automaticCompletionPending', value)
            .then(undefined, () => undefined);
    }
    setPending(false);
```

```ts : <<language feature automatic freshness>>=
    function current(edit: Edit): boolean {
        const editor = vscode.window.activeTextEditor;
        return !disposed && candidate === edit && epoch === edit.revision
            && vscode.window.state.focused && editor === edit.editor && editor.document === edit.document
            && edit.document.version === edit.version && enabled(edit.document)
            && editor.selections.length === 1 && editor.selection.isEmpty
            && editor.selection.active.isEqual(edit.cursor);
    }
```

Prefetch uses the normal projection and payload validators. Only nonempty valid
items open suggestions, and the provider consumes exactly one matching cache,
discarding its candidate immediately. Widget-token cancellation then has no stale
candidate to retain and must not cancel a newer edit. Arrays deliberately make no incomplete-result claim. No Markdown settings or
Markdown-wide trigger registrations are needed.

```ts : <<language feature automatic drain>>=
    async function drain(): Promise<void> {
        if (busy || timer || !pending) { return; }
        const edit = pending; pending = undefined;
        if (!current(edit)) { if (candidate === edit) { cancelAutomatic(); } return; }
        const cancellation = new vscode.CancellationTokenSource();
        try {
            const result = await request(edit.document, edit.cursor, cancellation.token, 'completion', edit);
            if (!Array.isArray(result) || !result.length || !current(edit)) { return; }
            cached = { edit, items: result }; setPending(false);
            await vscode.commands.executeCommand('editor.action.triggerSuggest');
        } catch { if (candidate === edit) { cancelAutomatic(); } }
        finally {
            cancellation.dispose();
            if (candidate === edit) {
                setPending(false);
                if (cached?.edit !== edit) { cancelAutomatic(); }
            }
        }
    }
```

```ts : <<language feature automatic edits>>=
    function changed(event: vscode.TextDocumentChangeEvent): void {
        if (event.contentChanges.length === 0) { return; }
        epoch++; active?.abort(); cancelAutomatic(true);
        try {
            const editor = vscode.window.activeTextEditor;
            if (!editor || !vscode.window.state.focused || event.document !== editor.document
                || event.reason !== undefined || event.contentChanges.length !== 1
                || editor.selections.length !== 1 || !editor.selection.isEmpty || !enabled(event.document)
                || !Object.keys(servers()).length) { return; }
            const change = event.contentChanges[0];
            if (change.rangeLength !== 0 || change.text.length !== 1 || /[\r\n]/.test(change.text)) { return; }
            const cursor = event.document.positionAt(change.rangeOffset + 1), before = change.range.start;
            if (!editor.selection.active.isEqual(before) && !editor.selection.active.isEqual(cursor)) { return; }
            candidate = pending = { editor, document: event.document, cursor, version: event.document.version,
                revision: epoch, character: change.text, selectionSeen: false, body: localBody(event.document, cursor) };
            timer = setTimeout(() => { timer = undefined; void drain(); }, 200);
        } finally { setPending(candidate?.body ?? false); }
    }
```

```ts : <<language feature automatic events>>=
    context.subscriptions.push(vscode.window.onDidChangeActiveTextEditor(invalidate),
        vscode.window.onDidChangeWindowState(invalidate), vscode.workspace.onDidGrantWorkspaceTrust(reset),
        vscode.window.onDidChangeTextEditorSelection(event => {
            if (!candidate) { return; }
            if (event.textEditor === candidate.editor && !candidate.selectionSeen
                && event.kind === vscode.TextEditorSelectionChangeKind.Keyboard && current(candidate)) {
                candidate.selectionSeen = true; return;
            }
            invalidate();
        }), vscode.commands.registerCommand('literate.cancelAutomaticCompletion', () => {
            invalidate();
        }));
