## One operation with bounded foreground waiting

At most 32 foreground requests wait for the serialization gate. Cancellation and
freshness are checked before acquisition; foreground work precedes background work.
The operation owns initialization, full synchronization and its reply as one unit.
Every asynchronous boundary checks document version, the global revision epoch,
folder membership, trust, configuration and cancellation. Disk events invalidate
literate inputs and captured template paths. Paths changing during capture are
bounded and checked against the completed template input set. Non-input changes,
including publication outputs and transaction files, do not cancel cold startup.
New source files always invalidate; missing templates cannot yield suggestions.

```ts : <<language feature lifecycle>>=
export function registerLanguageFeatures(context: vscode.ExtensionContext,
    snapshot: (folder: vscode.WorkspaceFolder) => Promise<LanguageSnapshot>): void {
    type Session = { client: LanguageClient; failed: boolean; started?: boolean; stop?: () => void };
    const sessions = new Map<string, Session>();
    const snapshots = new Map<string, string>();
    let epoch = 0, busy = false, disposed = false;
    let active: AbortController | undefined;
    const invalidate = (): void => { epoch++; active?.abort(); cancelAutomatic(); wakeWaiters(); };
    const close = (client: LanguageClient): void => { void client.dispose().catch(() => undefined); };
    let invalidReported = false, capturing = false;
    const captureChanges = new Set<string>();
    const templatePaths = new Map<string, Set<string>>(), reported = new Set<string>();
    const reset = (): void => {
        invalidate(); invalidateInputs(); sessions.forEach(session => { session.stop?.(); if (!session.failed) { close(session.client); } });
        sessions.clear(); snapshots.clear(); templatePaths.clear(); reported.clear(); invalidReported = false;
    };
    context.subscriptions.push({ dispose() { disposed = true; reset(); } });
```

```ts : <<language feature serialization>>=
    const waiters = new Set<() => void>();
    function wakeWaiters(): void { for (const wake of [...waiters]) { wake(); } }
    async function acquire(signal: AbortSignal, fresh: () => boolean): Promise<boolean> {
        if (waiters.size >= 32) { return false; }
        while (busy && fresh()) {
            await new Promise<void>(resolve => {
                const wake = (): void => { waiters.delete(wake); signal.removeEventListener('abort', wake); resolve(); };
                waiters.add(wake); signal.addEventListener('abort', wake, { once: true });
                if (signal.aborted) { wake(); }
            });
        }
        if (!fresh()) { return false; }
        busy = true; return true;
    }
    function release(): void {
        active = undefined; busy = false; capturing = false; captureChanges.clear();
        wakeWaiters();
        queueMicrotask(() => { void drain(); void drainBackground(); });
    }
```

A failed capture clears only the affected folder's diagnostics. Buffer mismatches
are source evidence; focus and selection changes alone are not.

```ts : <<language feature snapshot validity>>=
    function invalidateFolder(folder: vscode.WorkspaceFolder): void {
        for (const key of sessions.keys()) {
            if (JSON.parse(key)[0] === folder.uri.toString()) { diagnostics.invalidate(key); }
        }
    }
    function acceptSnapshot(folder: vscode.WorkspaceFolder, documents: SourceDocument[], templates: Record<string, string>): void {
        const key = folder.uri.toString(), identity = JSON.stringify([documents, templates]);
        if (snapshots.get(key) !== identity) { invalidateFolder(folder); snapshots.set(key, identity); }
    }
    function matchesBuffers(folder: vscode.WorkspaceFolder, documents: SourceDocument[]): boolean {
        return vscode.workspace.textDocuments.filter(document => local(folder, document)).every(document => {
            const name = path.relative(folder.uri.fsPath, document.uri.fsPath).split(path.sep).join('/');
            return documents.some(source => source.path.replace(/^\.\//, '') === name && source.text === document.getText());
        });
    }
```

Failure disables that session until configuration changes or the user invokes
`literate.restartLanguageServers`. Cancellation is not failure. Restart invalidates
old work without releasing the serialization gate until it settles. Diagnostics
in the output channel are fixed, actionable messages, once per failed session or invalid configuration
revision, with at most 100 retained lines. No automatic restart loop is possible.

```ts : <<language feature diagnostics>>=
    const output = vscode.window.createOutputChannel('Literate Language Servers');
    let lines = 0;
    let sourceRevision = 0;
    const diagnostics = new LanguageDiagnostics(context, message => report(message));
    let backgroundTimer: ReturnType<typeof setTimeout> | undefined;
    const background = new Map<string, vscode.TextDocument>();
    function diagnosticEnabled(document: vscode.TextDocument): boolean {
        return vscode.workspace.getConfiguration('literate', document.uri).get<boolean>('languageDiagnostics', true);
    }
    function inputUri(uri: vscode.Uri): boolean {
        return uri.fsPath.endsWith('.literate') || [...templatePaths.values()].some(paths => paths.has(path.resolve(uri.fsPath)));
    }
    function invalidateInputs(): void {
        sourceRevision++; diagnostics.invalidate();
        if (backgroundTimer) { clearTimeout(backgroundTimer); backgroundTimer = undefined; }
        background.clear();
        if (!disposed) { for (const document of vscode.workspace.textDocuments) { scheduleBackground(document); } }
    }
    function scheduleBackground(document: vscode.TextDocument): void {
        const folder = vscode.workspace.getWorkspaceFolder(document.uri);
        if (disposed || !folder || !local(folder, document) || !diagnosticEnabled(document) || !Object.keys(servers()).length) { return; }
        background.set(folder.uri.toString(), document);
        if (backgroundTimer) { clearTimeout(backgroundTimer); }
        backgroundTimer = setTimeout(() => { backgroundTimer = undefined; void drainBackground(); }, 400);
    }
```

```ts : <<report language service failures>>=
    const report = (message: string): void => {
        if (disposed) { return; }
        if (lines >= 100) { output.clear(); lines = 0; }
        output.appendLine(message); lines++;
    };
    const reportOnce = (message: string): void => {
        if (!reported.has(message)) { reported.add(message); report(message); }
    };
    const invalid = (): void => {
        if (invalidReported) { return; }
        invalidReported = true;
        report('Invalid global literate.languageServers: use canonical language IDs, an absolute executable command, '
            + 'optional string-array args and object initializationOptions/configuration. Workspace overrides are ignored.');
    };
    context.subscriptions.push(output, vscode.commands.registerCommand('literate.restartLanguageServers', () => {
        if (!disposed) { reset(); }
    }));
```

## Debounce only the latest focused insertion

One candidate survives a busy initialization or hover, without a request queue.
Its version, cursor, editor and epoch must still agree after every asynchronous
boundary. The insertion's own keyboard selection event is acknowledged once;
other selection events cancel. The parent owns the default-true resource boolean
and an Escape binding for `literate.cancelAutomaticCompletion`, guarded exactly by
`editorTextFocus && literate.automaticCompletionPending && !suggestWidgetVisible && !findWidgetVisible && !renameInputVisible && !inSnippetMode`.
The command only cancels pending work; normal widget Escape remains untouched.
The context starts synchronously after local body verification, before debounce,
and clears before showing results. Every eligible edit rechecks local Markdown;
selection moves cancel. The asynchronous setContext delivery has no added wait.
No public event observes raw Escape. Text change events do not identify the originating
command: a one-character paste is indistinguishable from typing. Multi-character
paste, replacements, undo/redo and multi-cursor edits are rejected.

```ts : <<language feature automatic state>>=
    type Edit = { editor: vscode.TextEditor; document: vscode.TextDocument; cursor: vscode.Position;
        version: number; revision: number; character: string; selectionSeen: boolean; body: boolean };
    let candidate: Edit | undefined, pending: Edit | undefined;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let cached: { edit: Edit; items: CompletionResult } | undefined;
    let signatureCache: { edit: Edit; value: vscode.SignatureHelp } | undefined;
    const signatureTriggers = new Set(['(', ',']);
    let signatureRegistration: vscode.Disposable | undefined;
    const retained = new WeakMap<vscode.CompletionItem, { raw: ObjectValue; client: LanguageClient; fresh: () => boolean }>();
    function cancelAutomatic(keepContext = false): void {
        if (timer) { clearTimeout(timer); timer = undefined; }
        candidate = pending = undefined; cached = undefined; signatureCache = undefined;
        if (!keepContext) { setPending(false); }
    }
    function enabled(document: vscode.TextDocument): boolean {
        const folder = vscode.workspace.getWorkspaceFolder(document.uri);
        return !!folder && local(folder, document)
            && vscode.workspace.getConfiguration('literate', document.uri).get<boolean>('automaticCompletion', true);
    }
```

Context writes are issued in transition order, without awaiting or installing
state-changing promise callbacks. An old drain may only clear its own candidate;
its completion cannot clear the latest candidate's context or debounce timer.

```ts : <<language feature automatic context>>=
    let pendingContext: boolean | undefined;
    function setPending(value: boolean): void {
        if (pendingContext === value) { return; }
        pendingContext = value;
        void vscode.commands.executeCommand('setContext', 'literate.automaticCompletionPending', value)
            .then(undefined, () => undefined);
    }
    setPending(false);
```

Automatic-completion freshness is presented in [Coordinating language features in the editor](coordinating_language_features.html).

Prefetch uses the normal projection and payload validators. Only nonempty valid
items open suggestions, and the provider consumes exactly one matching cache,
discarding its candidate immediately. Widget-token cancellation then has no stale
candidate to retain and must not cancel a newer edit. Arrays deliberately make no incomplete-result claim. No Markdown settings or
Markdown-wide trigger registrations are needed.

```ts : <<language feature automatic drain>>=
    async function drain(): Promise<void> {
        if (busy || timer || !pending) { return; }
        const edit = pending; pending = undefined;
        if (!current(edit)) { if (candidate === edit) { cancelAutomatic(); } return; }
        const cancellation = new vscode.CancellationTokenSource();
        try {
            const method = signatureTriggers.has(edit.character) ? 'signatureHelp' : 'completion';
            const result = await request(edit.document, edit.cursor, cancellation.token, method, edit);
            if (!result || !current(edit)) { return; }
            if (result instanceof vscode.SignatureHelp) {
                signatureCache = { edit, value: result as vscode.SignatureHelp }; setPending(false);
                await vscode.commands.executeCommand('editor.action.triggerParameterHints');
            } else {
                if (!completionItems(result as CompletionResult).length) { return; }
                cached = { edit, items: result as CompletionResult }; setPending(false);
                await vscode.commands.executeCommand('editor.action.triggerSuggest');
            }
        } catch { if (candidate === edit) { cancelAutomatic(); } }
        finally {
            cancellation.dispose();
            if (candidate === edit) {
                setPending(false);
                if (cached?.edit !== edit && signatureCache?.edit !== edit) { cancelAutomatic(); }
            }
        }
    }
```

```ts : <<language feature automatic edits>>=
    function changed(event: vscode.TextDocumentChangeEvent): void {
        if (event.contentChanges.length === 0) { return; }
        if (!inputUri(event.document.uri)) { diskChanged(event.document.uri); return; }
        invalidateInputs();
        epoch++; active?.abort(); cancelAutomatic(true); wakeWaiters();
        try {
            const editor = vscode.window.activeTextEditor;
            if (!editor || !vscode.window.state.focused || event.document !== editor.document
                || event.reason !== undefined || event.contentChanges.length !== 1
                || editor.selections.length !== 1 || !editor.selection.isEmpty || !enabled(event.document)
                || !Object.keys(servers()).length) { return; }
            const change = event.contentChanges[0];
            if (change.rangeLength !== 0 || change.text.length !== 1 || /[\r\n]/.test(change.text)) { return; }
            const cursor = event.document.positionAt(change.rangeOffset + 1), before = change.range.start;
            if (!editor.selection.active.isEqual(before) && !editor.selection.active.isEqual(cursor)) { return; }
            candidate = pending = { editor, document: event.document, cursor, version: event.document.version,
                revision: epoch, character: change.text, selectionSeen: false, body: localBody(event.document, cursor) };
            timer = setTimeout(() => { timer = undefined; void drain(); }, 200);
        } finally { setPending(candidate?.body ?? false); }
    }
```

```ts : <<language feature automatic events>>=
    context.subscriptions.push(vscode.window.onDidChangeActiveTextEditor(invalidate),
        vscode.window.onDidChangeWindowState(invalidate), vscode.workspace.onDidGrantWorkspaceTrust(reset),
        vscode.window.onDidChangeTextEditorSelection(event => {
            if (!candidate) { invalidate(); return; }
            if (event.textEditor === candidate.editor && !candidate.selectionSeen
                && event.kind === vscode.TextEditorSelectionChangeKind.Keyboard && current(candidate)) {
                candidate.selectionSeen = true; return;
            }
            invalidate();
        }), vscode.commands.registerCommand('literate.cancelAutomaticCompletion', () => {
            invalidate();
        }));
