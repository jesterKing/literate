{
  "name": "literate",
  "displayName": "Literate Programming",
  "description": "Literate Programming for vscode",
  "publisher": "jesterking",
  "icon": "media/literate_programming.png",
  "repository": {
    "url": "https://github.com/jesterKing/literate"
  },
  "version": "0.14.4",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "literate",
    "paradigm",
    "documentation",
    "literate programming"
  ],
  "license": "MIT",
  "author": {
    "name": "Nathan 'jesterKing' Letwory",
    "email": "jesterking@letwory.net",
    "url": "https://letworyinteractive.com"
  },
  "activationEvents": [],
  "main": "./out/main.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "fragmentExplorer",
          "name": "Literate Fragments",
          "icon": "$(book)",
          "contextualTitle": "Literate Fragment Explorer"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "fragmentExplorer.refreshEntry",
          "when": "view == fragmentExplorer",
          "group": "navigation"
        }
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./out/mermaid-preview.js"
    ],
    "configuration": {
      "title": "Literate publication",
      "properties": {
        "literate.publication.nodePath": {
          "type": "string", "default": "", "scope": "machine", "restricted": true,
          "description": "Absolute path to external Node.js >=22.12 for explicit publication. Electron is unsupported; workspace overrides are ignored."
        },
        "literate.publication.browserPath": {
          "type": "string", "default": "", "scope": "machine", "restricted": true,
          "description": "Optional absolute path to an installed sandbox-capable Chromium for Mermaid publication. No browser is downloaded; workspace overrides are ignored."
        },
        "literate.publication.fontManifest": {
          "type": "string", "default": "", "scope": "machine", "restricted": true,
          "description": "Optional publication font manifest path relative to the selected workspace folder."
        }
      }
    },
    "commands": [
      { "command": "literate.exportLatex", "title": "Literate: Export LaTeX", "enablement": "isWorkspaceTrusted" },
      { "command": "literate.exportPdf", "title": "Literate: Export PDF", "enablement": "isWorkspaceTrusted" },
      {
        "command": "literate.process",
        "title": "Literate: Process"
      },
      {
        "command": "literate.create_fragment_for_tag",
        "title": "Literate: Create Fragment For Tag"
      },
      {
        "command": "literate.split_fragment",
        "title": "Literate: Split Fragment"
      },
      {
        "command": "fragmentExplorer.refreshEntry",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:publication": "node ./src/build-publication.mjs",
    "build:mermaid-browser": "node ./src/build-publication.mjs --browser",
    "build:mermaid-worker": "node ./src/build-publication.mjs --worker",
    "build:cli": "yarn build:mermaid-worker && esbuild ./src/cli-entry.ts --bundle --outfile=out/cli-entry.js --external:typescript --external:esbuild --external:markdown-it --external:highlight.js --format=cjs --platform=node --log-level=error",
    "literate": "yarn build:cli && node ./out/cli-entry.js",
    "generate": "yarn literate generate",
    "check:generated": "yarn literate check",
    "check:self": "yarn literate self-check",
    "lint": "eslint src --ext ts",
    "test": "yarn build:mermaid-worker && yarn compile && yarn lint && node --test out/test/headless/*.test.js && node ./out/cli-entry.js check",
    "test:extension": "yarn compile && yarn esbuild && node ./out/test/runTest.js",
    "test:publication": "yarn build:cli && python3 src/test/acceptance/portable-layout.py",
    "test:pdf": "yarn build:cli && python3 src/test/acceptance/portable-pdf.py",
    "test:annotations": "yarn build:cli && python3 src/test/acceptance/portable-annotations.py",
    "test:assets": "yarn build:cli && python3 src/test/acceptance/portable-assets.py",
    "test:mermaid": "yarn build:cli && python3 src/test/acceptance/portable-mermaid.py",
    "test:browser-security": "yarn compile && yarn build:mermaid-worker && node src/test/acceptance/mermaid-security.mjs",
    "vscode:prepublish": "npm run -S esbuild-base -- --minify",
    "build:preview": "esbuild ./src/mermaid-preview.js --bundle --outfile=out/mermaid-preview.js --format=iife --platform=browser --target=chrome128 --minify",
    "watch:preview": "yarn build:preview --watch",
    "esbuild-base": "yarn build:preview && yarn build:publication && esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "esbuild": "npm run -S esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run -S esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./"
  },
  "devDependencies": {
    "@mermaid-js/layout-tidy-tree": "1.0.1",
    "@mermaid-js/mermaid-zenuml": "1.0.1",
    "@types/glob": "^7.1.3",
    "@types/markdown-it": "^12.0.1",
    "@types/mocha": "^8.0.4",
    "@types/node": "^20.10.5",
    "@types/vscode": "^1.63.2",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "@vscode/test-electron": "^2.3.8",
    "esbuild": "0.28.2",
    "eslint": "^8.56.0",
    "glob": "^7.1.6",
    "mocha": ">8.2.1",
    "puppeteer-core": "25.12.0",
    "typescript": "^4.1.3",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.9.1"
  },
  "dependencies": {
    "highlight.js": "^11.0.1",
    "markdown-it": "^12.3.2",
    "mermaid": "12.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
